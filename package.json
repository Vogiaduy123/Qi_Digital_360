    "test:strix": "powershell -ExecutionPolicy Bypass -File .\\scripts\\strix-test.ps1",
    "test:strix:reset": "powershell -ExecutionPolicy Bypass -File .\\scripts\\strix-test.ps1 -Reset",
    "test:strix:restore": "powershell -ExecutionPolicy Bypass -File .\\scripts\\strix-test.ps1 -Restore",
    "test:strix:finish": "powershell -ExecutionPolicy Bypass -File .\\scripts\\strix-finish.ps1",
    "test:scan": "node scripts/run-security-scan.js"
  },
