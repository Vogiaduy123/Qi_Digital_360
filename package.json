  "main": "server.js",
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test": "npm run check && npm run build:ui",
    "start": "node server.js",
    "build": "vite build",
    "dev:ui": "vite",
    "build:ui": "vite build",
